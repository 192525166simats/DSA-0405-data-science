
import numpy as np
from scipy import stats

A = [2.5, 3.0, 2.8, 3.2, 2.9, 3.1, 2.7, 3.3]
B = [3.2, 3.5, 3.4, 3.1, 3.6, 3.3, 3.7, 3.4]

t, p = stats.ttest_ind(A, B)

print("Mean of Design A:", np.mean(A))
print("Mean of Design B:", np.mean(B))
print("T-statistic:", round(t, 3))
print("P-value:", round(p, 4))

if p < 0.05:
    print("Significant difference exists.")
else:
    print("No significant difference exists.")
