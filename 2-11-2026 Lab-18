
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

df = pd.DataFrame({
    'Age': [23, 27, 28, 30, 32, 35, 36, 38, 40,
            42, 45, 47, 49, 50, 52, 55, 58, 60],
    '%Fat': [12, 15, 18, 20, 22, 24, 25, 27, 29,
             30, 32, 34, 35, 37, 38, 40, 42, 45]
})

print("Mean:\n", df.mean())
print("\nMedian:\n", df.median())
print("\nStandard Deviation:\n", df.std())
df.plot(kind='box', subplots=True, layout=(1, 2))
plt.show()

plt.scatter(df['Age'], df['%Fat'])
plt.xlabel("Age")
plt.ylabel("% Fat")
plt.title("Age vs Body Fat")
plt.show()

for col in df.columns:
    stats.probplot(df[col], dist="norm", plot=plt)
    plt.title("Q-Q Plot of " + col)
    plt.show()
